#include <winver.h>

IDI_ICON ICON "resource/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VS_FF_PRERELEASE
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "Ableton RU Hotkeys"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "ableton-ru-hotkeys"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "ableton-ru-hotkeys.exe"
            VALUE "ProductName",      "Ableton RU Hotkeys"
            VALUE "ProductVersion",   "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
