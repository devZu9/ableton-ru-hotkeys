#pragma code_page(65001)
#include <windows.h>

#define IDI_APP 101
#define IDD_SETTINGS 102
#define IDD_SPLASH 104
#define IDC_AUTOSTART     1000
#define IDC_START_MINIMIZED 1001
#define IDC_SAVE          1002

IDI_APP ICON "resource/icon.ico"

IDD_SPLASH DIALOGEX 0, 0, 300, 130
STYLE DS_SETFONT | DS_CENTER | WS_POPUP
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CTEXT "Ableton RU Hotkeys", -1, 10, 20, 280, 25
    CTEXT "Версия 1.0", -1, 10, 48, 280, 15
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 10, 70, 280, 1
    CTEXT "Автоматическое переключение раскладки", -1, 10, 80, 280, 15
    CTEXT "для горячих клавиш в Ableton Live", -1, 10, 98, 280, 15
END

IDD_SETTINGS DIALOGEX 0, 0, 310, 120
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL "Автозагрузка при старте системы", IDC_AUTOSTART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 15, 280, 15
    CONTROL "Запускать в свёрнутом виде", IDC_START_MINIMIZED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 38, 280, 15
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 15, 62, 280, 1
    CONTROL "Сохранить", IDC_SAVE, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP, 90, 80, 90, 25
    CONTROL "Отмена", IDCANCEL, "Button", BS_PUSHBUTTON | WS_TABSTOP, 180, 80, 90, 25
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "Ableton RU Hotkeys"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ableton-ru-hotkeys"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "ableton-ru-hotkeys.exe"
            VALUE "ProductName",      "Ableton RU Hotkeys"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
